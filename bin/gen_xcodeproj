#!/usr/bin/env ruby
# bin/gen_xcodeproj
#
# Implements PR 13: generate TextMate.xcodeproj directly (no xcodegen needed).
#
# The generated Xcode project:
#   • Uses PBXNativeTarget for each top-level ninja target, so Xcode knows
#     the product type (app / tool / bundle) while the build action invokes
#     ninja rather than its own compiler.
#   • Shows source trees as folder references (blue folders) so new files
#     added to the filesystem appear in Xcode automatically — true FS
#     references, no ./configure re-run required.
#   • Redirects ninja's builddir to $BUILD_DIR/ninja so all intermediate
#     objects and final products land in DerivedData.
#   • Rsyncs every built product to $BUILT_PRODUCTS_DIR so Xcode's Run,
#     Debug, and Profile scheme actions can find and launch it.
#
# Called by ./configure, or run manually.
# Usage: bin/gen_xcodeproj [--skip-symlinks]

require 'fileutils'
require 'digest'

SRCROOT = File.expand_path('..', __dir__)
Dir.chdir(SRCROOT)

skip_symlinks = ARGV.include?('--skip-symlinks')

# -----------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------

# Deterministic 24-char Xcode UUID derived from a seed string.
def uuid(seed)
  Digest::MD5.hexdigest("gen_xcodeproj:#{seed}").upcase[0, 24]
end

# Quote a value for Xcode's ASCII plist format.
def q(val)
  s = val.to_s
  return '""' if s.empty?
  s =~ /\A[A-Za-z0-9_.\/\-]+\z/ ? s : '"' + s.gsub('\\', '\\\\\\\\').gsub('"', '\\"').gsub("\n", "\\n") + '"'
end

# -----------------------------------------------------------------------
# Check for xcodebuild (we still need it to detect the Xcode version)
# -----------------------------------------------------------------------

xcode_version = `xcodebuild -version 2>/dev/null`.split("\n").first
                  &.sub('Xcode ', '')&.strip || 'unknown'
puts "Detected Xcode #{xcode_version}"

# -----------------------------------------------------------------------
# Create build/include/ header symlinks
# -----------------------------------------------------------------------
# Lets IDE features (jump-to-definition, code completion) follow headers
# like <text/format.h> through build/include/text/ → Frameworks/text/src/.
# 'network' is excluded to avoid shadowing Apple's Network.framework.

unless skip_symlinks
  FileUtils.mkdir_p('build/include')
  Dir.glob('Frameworks/*/src').each do |src|
    name = File.basename(File.dirname(src))
    next if name == 'network'
    link = "build/include/#{name}"
    dest = "../../#{src}"
    unless File.symlink?(link)
      File.symlink(dest, link)
      puts "  Symlink: #{link} → #{dest}"
    end
  end

  FileUtils.mkdir_p('build/include-network')
  unless File.symlink?('build/include-network/network')
    File.symlink('../../Frameworks/network/src', 'build/include-network/network')
    puts "  Symlink: build/include-network/network"
  end

  if Dir.exist?('vendor/Onigmo/vendor') && !File.symlink?('build/include/Onigmo')
    File.symlink('../../vendor/Onigmo/vendor', 'build/include/Onigmo')
    puts "  Symlink: build/include/Onigmo"
  end
end

