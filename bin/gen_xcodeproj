# Fall-back metadata for any target not listed in TARGET_META above.
def default_meta_for(name, type)
  case type
  when :app
    { product_type: 'com.apple.product-type.application',
      product_name: "#{name}.app",
      file_type:    'wrapper.application',
      ninja_path:   "Applications/#{name}/#{name}.app",
      settings:     {} }
  when :bundle
    { product_type: 'com.apple.product-type.bundle',
      product_name: name,
      file_type:    'wrapper.cfbundle',
      ninja_path:   "PlugIns/#{name}/#{name}",
      settings:     {} }
  else # :tool
    { product_type: 'com.apple.product-type.tool',
      product_name: name,
      file_type:    'compiled.mach-o.executable',
      ninja_path:   "Applications/#{name}/#{name}",
      settings:     {} }
  end
end

# -----------------------------------------------------------------------
# Discover top-level ninja targets from build.ninja
# -----------------------------------------------------------------------
# Top-level targets: "build <Name>/release: phony <product-path>"
#   product contains .app/        → :app
#   product contains .tmplugin/   → :bundle
#   product contains .qlgenerator/→ :bundle
#   otherwise                     → :tool

NINJA_TARGETS = []
TARGET_TYPES  = {}

unless File.exist?('build.ninja')
  abort "*** build.ninja not found.  Run ./configure first."
end

IO.foreach('build.ninja', encoding: 'binary:UTF-8', invalid: :replace) do |line|
  m = line.match(/^build ([A-Za-z][A-Za-z0-9_]*)\/release: phony (.+)$/)
  next unless m
  name = m[1]; path = m[2].strip
  type = if    path.include?('.app/')          then :app
           elsif path.include?('.tmplugin/')    then :bundle
           elsif path.include?('.qlgenerator/') then :bundle
           else                                     :tool
           end
  NINJA_TARGETS << name
  TARGET_TYPES[name] = type
end

abort "*** No targets found in build.ninja." if NINJA_TARGETS.empty?
puts "Found #{NINJA_TARGETS.size} targets: #{NINJA_TARGETS.join(', ')}"

# Look up metadata for a target, falling back to defaults for unknown targets.
def meta_for(name)
  TARGET_META[name] || default_meta_for(name, TARGET_TYPES[name])
end

# -----------------------------------------------------------------------
# Build script content for each target
# -----------------------------------------------------------------------

COMMON_PREAMBLE = <<~'BASH'
  #!/bin/sh
  set -e
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
  cd "$SRCROOT"

  # Map Xcode configuration → ninja variant.
  case "${CONFIGURATION}" in
    Debug) NINJA_CONF=debug  ;;
    *)     NINJA_CONF=release ;;
  esac

  # Use the builddir rave configured when ./configure was run.
  # We intentionally do NOT redirect this to Xcode's BUILD_DIR: doing so would
  # rewrite build.ninja, causing ninja's generator rule (MakeBuildfile) to
  # re-invoke rave without the -b flag — resetting builddir and defeating the
  # redirect on every build.
  NINJA_BUILDDIR=$(awk 'NR==1 && /^builddir/{print $3}' build.ninja 2>/dev/null || echo "build")
BASH

def build_script_for(name, _type_ignored)
  meta   = meta_for(name)
  path   = meta[:ninja_path]
  pname  = meta[:product_name]
  # Bundle products (apps, plugins, frameworks) are directories; tools are
  # plain files.  We detect by whether the product name has an extension.
  is_bundle = pname =~ /\.(app|tmplugin|qlgenerator|framework|xctest|bundle)\z/

  s = COMMON_PREAMBLE.dup
  s << "\nninja \"#{name}/${NINJA_CONF}\"\n"
  if is_bundle
    s << <<~BASH

      # Sync the built product to $BUILT_PRODUCTS_DIR so Xcode's Run/Debug/Profile work.
      rsync -a --delete \\
        "${NINJA_BUILDDIR}/${NINJA_CONF}/#{path}/" \\
        "${BUILT_PRODUCTS_DIR}/#{pname}/"
    BASH
  else
    s << <<~BASH

      # Copy the built product to $BUILT_PRODUCTS_DIR so Xcode's Run/Debug/Profile work.
      rsync -a \\
        "${NINJA_BUILDDIR}/${NINJA_CONF}/#{path}" \\
        "${BUILT_PRODUCTS_DIR}/#{pname}"
    BASH
  end
  s
end

# -----------------------------------------------------------------------
# pbxproj generation helpers
# -----------------------------------------------------------------------

# Folder references shown as source groups in the project navigator.
# Using PBXFileReference with lastKnownFileType=folder creates a "blue folder"
# (true FS reference) that auto-updates when files are added — no ./configure
# re-run required.
FOLDER_GROUPS = %w[Applications Frameworks PlugIns Shared xcconfigs bin]

# UUIDs ---------------------------------------------------------------
PROJ_UUID        = uuid('project')
ROOT_GROUP_UUID  = uuid('root_group')
PRODUCTS_UUID    = uuid('products_group')
PROJ_CFGLIST     = uuid('project_cfglist')
PROJ_CFG_DEBUG   = uuid('project_cfg_debug')
PROJ_CFG_RELEASE = uuid('project_cfg_release')

# xcconfig file references (for baseConfigurationReference on project configs)
XCCONFIG_DEBUG_UUID   = uuid('xcconfig_debug')
XCCONFIG_RELEASE_UUID = uuid('xcconfig_release')

folder_uuids  = FOLDER_GROUPS.each_with_object({}) { |g, h| h[g] = uuid("folder:#{g}") }

target_uuids  = NINJA_TARGETS.each_with_object({}) { |n, h| h[n] = uuid("target:#{n}") }
phase_uuids   = NINJA_TARGETS.each_with_object({}) { |n, h| h[n] = uuid("phase:#{n}") }
cfglist_uuids = NINJA_TARGETS.each_with_object({}) { |n, h| h[n] = uuid("cfglist:#{n}") }
cfg_dbg_uuids = NINJA_TARGETS.each_with_object({}) { |n, h| h[n] = uuid("cfg_dbg:#{n}") }
cfg_rel_uuids = NINJA_TARGETS.each_with_object({}) { |n, h| h[n] = uuid("cfg_rel:#{n}") }
product_uuids = NINJA_TARGETS.each_with_object({}) { |n, h| h[n] = uuid("product:#{n}") }

# -----------------------------------------------------------------------
# Write project.pbxproj
# -----------------------------------------------------------------------

def pbx_list(items, indent = 3)
  pad = "\t" * indent
  items.empty? ? "()" : "(\n#{items.map { |i| "#{pad}#{i}," }.join("\n")}\n#{"\t" * (indent - 1)})"
end

pbxproj = []
pbxproj << '// !$*UTF8*$!'
pbxproj << '{'
pbxproj << "\tarchiveVersion = 1;"
pbxproj << "\tclasses = {};"
pbxproj << "\tobjectVersion = 56;"
pbxproj << "\tobjects = {"
pbxproj << ""

# ── PBXNativeTarget ───────────────────────────────────────────────────
pbxproj << "\t\t/* Begin PBXNativeTarget section */"
NINJA_TARGETS.each do |name|
  meta       = meta_for(name)
  pname_stem = meta[:product_name].sub(/\.[^.]+$/, '')   # e.g. "TextMate", "Dialog"
  pbxproj << "\t\t#{target_uuids[name]} /* #{name} */ = {"
  pbxproj << "\t\t\tisa = PBXNativeTarget;"
  pbxproj << "\t\t\tbuildConfigurationList = #{cfglist_uuids[name]} /* Build configuration list for PBXNativeTarget \"#{name}\" */;"
  pbxproj << "\t\t\tbuildPhases = ("
  pbxproj << "\t\t\t\t#{phase_uuids[name]} /* Build #{name} (ninja) */,"
  pbxproj << "\t\t\t);"
  pbxproj << "\t\t\tbuildRules = ();"
  pbxproj << "\t\t\tdependencies = ();"
  pbxproj << "\t\t\tname = #{q(name)};"
  pbxproj << "\t\t\tproductName = #{q(pname_stem)};"
  pbxproj << "\t\t\tproductReference = #{product_uuids[name]} /* #{meta[:product_name]} */;"
  pbxproj << "\t\t\tproductType = \"#{meta[:product_type]}\";"
  pbxproj << "\t\t};"
end
pbxproj << "\t\t/* End PBXNativeTarget section */"
pbxproj << ""

# ── PBXFileReference (folder refs + xcconfig refs + product refs) ─────
pbxproj << "\t\t/* Begin PBXFileReference section */"

# Blue-folder references (navigator source trees)
FOLDER_GROUPS.each do |g|
  pbxproj << "\t\t#{folder_uuids[g]} /* #{g} */ = {isa = PBXFileReference; lastKnownFileType = folder; name = #{q(g)}; path = #{q(g)}; sourceTree = #{q('<group>')}; };"
end

# xcconfig files (referenced for baseConfigurationReference)
pbxproj << "\t\t#{XCCONFIG_DEBUG_UUID} /* Debug.xcconfig */ = {isa = PBXFileReference; fileEncoding = 4; lastKnownFileType = text.xcconfig; name = \"Debug.xcconfig\"; path = \"xcconfigs/Debug.xcconfig\"; sourceTree = SOURCE_ROOT; };"
pbxproj << "\t\t#{XCCONFIG_RELEASE_UUID} /* Release.xcconfig */ = {isa = PBXFileReference; fileEncoding = 4; lastKnownFileType = text.xcconfig; name = \"Release.xcconfig\"; path = \"xcconfigs/Release.xcconfig\"; sourceTree = SOURCE_ROOT; };"

# Product file references (live in BUILT_PRODUCTS_DIR after each build)
NINJA_TARGETS.each do |name|
  meta = meta_for(name)
  pbxproj << "\t\t#{product_uuids[name]} /* #{meta[:product_name]} */ = {isa = PBXFileReference; explicitFileType = #{meta[:file_type]}; includeInIndex = 0; path = #{q(meta[:product_name])}; sourceTree = BUILT_PRODUCTS_DIR; };"
end

pbxproj << "\t\t/* End PBXFileReference section */"
pbxproj << ""

# ── PBXGroup ──────────────────────────────────────────────────────────
pbxproj << "\t\t/* Begin PBXGroup section */"

# Products group — populated with one entry per target
pbxproj << "\t\t#{PRODUCTS_UUID} /* Products */ = {"
pbxproj << "\t\t\tisa = PBXGroup;"
pbxproj << "\t\t\tchildren = ("
NINJA_TARGETS.each { |n| pbxproj << "\t\t\t\t#{product_uuids[n]} /* #{meta_for(n)[:product_name]} */," }
pbxproj << "\t\t\t);"
pbxproj << "\t\t\tname = Products;"
pbxproj << "\t\t\tsourceTree = #{q('<group>')};"
pbxproj << "\t\t};"

# Root group: folder references first, then Products
root_children = FOLDER_GROUPS.map { |g| "#{folder_uuids[g]} /* #{g} */" } + ["#{PRODUCTS_UUID} /* Products */"]
pbxproj << "\t\t#{ROOT_GROUP_UUID} = {"
pbxproj << "\t\t\tisa = PBXGroup;"
pbxproj << "\t\t\tchildren = ("
root_children.each { |c| pbxproj << "\t\t\t\t#{c}," }
pbxproj << "\t\t\t);"
pbxproj << "\t\t\tsourceTree = #{q('<group>')};"
pbxproj << "\t\t};"
pbxproj << "\t\t/* End PBXGroup section */"
pbxproj << ""

# ── PBXProject ────────────────────────────────────────────────────────
pbxproj << "\t\t/* Begin PBXProject section */"
pbxproj << "\t\t#{PROJ_UUID} /* Project object */ = {"
pbxproj << "\t\t\tisa = PBXProject;"
pbxproj << "\t\t\tattributes = {"
pbxproj << "\t\t\tBuildIndependentTargetsInParallel = YES;"
pbxproj << "\t\t\t};"
pbxproj << "\t\t\tbuildConfigurationList = #{PROJ_CFGLIST};"
pbxproj << "\t\t\tcompatibilityVersion = #{q('Xcode 14.0')};"
pbxproj << "\t\t\tdevelopmentRegion = en;"
pbxproj << "\t\t\thasScannedForEncodings = 0;"
pbxproj << "\t\t\tknownRegions = (en, Base);"
pbxproj << "\t\t\tmainGroup = #{ROOT_GROUP_UUID};"
pbxproj << "\t\t\tproductRefGroup = #{PRODUCTS_UUID};"
pbxproj << "\t\t\tprojectDirPath = #{q('')};"
pbxproj << "\t\t\tprojectRoot = #{q('')};"
pbxproj << "\t\t\ttargets = ("
NINJA_TARGETS.each { |n| pbxproj << "\t\t\t\t#{target_uuids[n]} /* #{n} */," }
pbxproj << "\t\t\t);"
pbxproj << "\t\t};"
pbxproj << "\t\t/* End PBXProject section */"
pbxproj << ""

# ── PBXShellScriptBuildPhase ─────────────────────────────────────────
pbxproj << "\t\t/* Begin PBXShellScriptBuildPhase section */"
NINJA_TARGETS.each do |name|
  script = build_script_for(name, TARGET_TYPES[name])
  pbxproj << "\t\t#{phase_uuids[name]} /* Build #{name} (ninja) */ = {"
  pbxproj << "\t\t\tisa = PBXShellScriptBuildPhase;"
  pbxproj << "\t\t\talwaysOutOfDate = 1;"
  pbxproj << "\t\t\tbuildActionMask = 2147483647;"
  pbxproj << "\t\t\tfiles = ();"
  pbxproj << "\t\t\tinputFileListPaths = ();"
  pbxproj << "\t\t\tinputPaths = ();"
  pbxproj << "\t\t\tname = #{q("Build #{name} (ninja)")};"
  pbxproj << "\t\t\toutputFileListPaths = ();"
  pbxproj << "\t\t\toutputPaths = ();"
  pbxproj << "\t\t\trunOnlyForDeploymentPostprocessing = 0;"
  pbxproj << "\t\t\tshellPath = /bin/sh;"
  pbxproj << "\t\t\tshellScript = #{q(script)};"
  pbxproj << "\t\t\tshowEnvVarsInLog = 0;"
  pbxproj << "\t\t};"
end
pbxproj << "\t\t/* End PBXShellScriptBuildPhase section */"
pbxproj << ""

# ── XCBuildConfiguration ─────────────────────────────────────────────
pbxproj << "\t\t/* Begin XCBuildConfiguration section */"

# Project-level configurations — backed by xcconfigs/Debug.xcconfig etc.
[['Debug',   PROJ_CFG_DEBUG,   XCCONFIG_DEBUG_UUID,   'Debug.xcconfig'],
 ['Release', PROJ_CFG_RELEASE, XCCONFIG_RELEASE_UUID, 'Release.xcconfig']].each do |cfg, u, xccu, xccn|
  pbxproj << "\t\t#{u} /* #{cfg} */ = {"
  pbxproj << "\t\t\tisa = XCBuildConfiguration;"
  pbxproj << "\t\t\tbaseConfigurationReference = #{xccu} /* #{xccn} */;"
  pbxproj << "\t\t\tbuildSettings = {"
  pbxproj << "\t\t\t};"
  pbxproj << "\t\t\tname = #{cfg};"
  pbxproj << "\t\t};"
end

# Per-target configurations — PRODUCT_NAME plus all metadata settings, sorted.
NINJA_TARGETS.each do |name|
  meta       = meta_for(name)
  pname_stem = meta[:product_name].sub(/\.[^.]+$/, '')
  settings   = { 'PRODUCT_NAME' => pname_stem }.merge(meta[:settings])
  { 'Debug' => cfg_dbg_uuids[name], 'Release' => cfg_rel_uuids[name] }.each do |cfg, u|
    pbxproj << "\t\t#{u} /* #{cfg} */ = {"
    pbxproj << "\t\t\tisa = XCBuildConfiguration;"
    pbxproj << "\t\t\tbuildSettings = {"
    settings.sort.each { |k, v| pbxproj << "\t\t\t\t#{k} = #{q(v)};" }
    pbxproj << "\t\t\t};"
    pbxproj << "\t\t\tname = #{cfg};"
    pbxproj << "\t\t};"
  end
end
pbxproj << "\t\t/* End XCBuildConfiguration section */"
pbxproj << ""

# ── XCConfigurationList ───────────────────────────────────────────────
pbxproj << "\t\t/* Begin XCConfigurationList section */"

pbxproj << "\t\t#{PROJ_CFGLIST} /* Build configuration list for PBXProject \"TextMate\" */ = {"
pbxproj << "\t\t\tisa = XCConfigurationList;"
pbxproj << "\t\t\tbuildConfigurations = ("
pbxproj << "\t\t\t\t#{PROJ_CFG_DEBUG} /* Debug */,"
pbxproj << "\t\t\t\t#{PROJ_CFG_RELEASE} /* Release */,"
pbxproj << "\t\t\t);"
pbxproj << "\t\t\tdefaultConfigurationIsVisible = 0;"
pbxproj << "\t\t\tdefaultConfigurationName = Release;"
pbxproj << "\t\t};"

NINJA_TARGETS.each do |name|
  pbxproj << "\t\t#{cfglist_uuids[name]} /* Build configuration list for PBXNativeTarget \"#{name}\" */ = {"
  pbxproj << "\t\t\tisa = XCConfigurationList;"
  pbxproj << "\t\t\tbuildConfigurations = ("
  pbxproj << "\t\t\t\t#{cfg_dbg_uuids[name]} /* Debug */,"
  pbxproj << "\t\t\t\t#{cfg_rel_uuids[name]} /* Release */,"
  pbxproj << "\t\t\t);"
  pbxproj << "\t\t\tdefaultConfigurationIsVisible = 0;"
  pbxproj << "\t\t\tdefaultConfigurationName = Release;"
  pbxproj << "\t\t};"
end
pbxproj << "\t\t/* End XCConfigurationList section */"
pbxproj << ""

pbxproj << "\t};"
pbxproj << "\trootObject = #{PROJ_UUID} /* Project object */;"
pbxproj << "}"

# -----------------------------------------------------------------------
# Write the .xcodeproj package
# -----------------------------------------------------------------------

proj_dir = 'TextMate.xcodeproj'
FileUtils.mkdir_p(proj_dir)
File.write("#{proj_dir}/project.pbxproj", pbxproj.join("\n") + "\n")
puts "Wrote #{proj_dir}/project.pbxproj"

# -----------------------------------------------------------------------
# Write xcscheme files
# -----------------------------------------------------------------------
# Each scheme invokes the corresponding Xcode target.  For app and tool
# targets we add a BuildableProductRunnable so Xcode's Run action can
# find and launch the product from $BUILT_PRODUCTS_DIR (where the build
# script rsyncs / copies it).  Bundle targets (plugins, QL generators)
# have no runnable since they cannot be launched directly.

schemes_dir = "#{proj_dir}/xcshareddata/xcschemes"
FileUtils.mkdir_p(schemes_dir)

NINJA_TARGETS.each do |name|
  meta       = meta_for(name)
  type       = TARGET_TYPES[name]
  target_ref = target_uuids[name]
  prod_name  = meta[:product_name]

  # Build the LaunchAction runnable element.
  # - apps and tools → BuildableProductRunnable (Xcode tracks the product)
  # - bundles        → empty (no standalone launch)
  if type != :bundle
    launch_runnable = <<~XML
            <BuildableProductRunnable
               runnableDebuggingMode = "0">
               <BuildableReference
                  BuildableIdentifier = "primary"
                  BlueprintIdentifier = "#{target_ref}"
                  BuildableName = "#{prod_name}"
                  BlueprintName = "#{name}"
                  ReferencedContainer = "container:TextMate.xcodeproj">
               </BuildableReference>
            </BuildableProductRunnable>
    XML
    launch_debugger  = 'Xcode.DebuggerFoundation.Debugger.LLDB'
    launch_launcher  = 'Xcode.DebuggerFoundation.Launcher.LLDB'
  else
    launch_runnable = ""
    launch_debugger = ""
    launch_launcher = "Xcode.IDEFoundation.Launcher.PosixSpawn"
  end

  scheme = <<~XML
    <?xml version="1.0" encoding="UTF-8"?>
    <Scheme
       LastUpgradeVersion = "#{xcode_version.delete('.').ljust(4, '0')}"
       version = "1.3">
       <BuildAction
          parallelizeBuildables = "YES"
          buildImplicitDependencies = "YES">
          <BuildActionEntries>
             <BuildActionEntry
                buildForTesting = "YES"
                buildForRunning = "YES"
                buildForProfiling = "YES"
                buildForArchiving = "YES"
                buildForAnalyzing = "YES">
                <BuildableReference
                   BuildableIdentifier = "primary"
                   BlueprintIdentifier = "#{target_ref}"
                   BuildableName = "#{prod_name}"
                   BlueprintName = "#{name}"
                   ReferencedContainer = "container:TextMate.xcodeproj">
                </BuildableReference>
             </BuildActionEntry>
          </BuildActionEntries>
       </BuildAction>
       <TestAction
          buildConfiguration = "Debug"
          selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
          selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
          shouldUseLaunchSchemeArgsEnv = "YES">
          <Testables>
          </Testables>
       </TestAction>
       <LaunchAction
          buildConfiguration = "Debug"
          selectedDebuggerIdentifier = "#{launch_debugger}"
          selectedLauncherIdentifier = "#{launch_launcher}"
          launchStyle = "0"
          useCustomWorkingDirectory = "NO"
          ignoresPersistentStateOnLaunch = "NO"
          debugDocumentVersioning = "YES"
          debugServiceExtension = "internal"
          allowLocationSimulation = "YES">
    #{launch_runnable.chomp}
       </LaunchAction>
       <ProfileAction
          buildConfiguration = "Release"
          shouldUseLaunchSchemeArgsEnv = "YES"
          savedToolIdentifier = ""
          useCustomWorkingDirectory = "NO"
          debugDocumentVersioning = "YES">
       </ProfileAction>
       <AnalyzeAction
          buildConfiguration = "Debug">
       </AnalyzeAction>
       <ArchiveAction
          buildConfiguration = "Release"
          revealArchiveInOrganizer = "YES">
       </ArchiveAction>
    </Scheme>
  XML

  scheme_path = "#{schemes_dir}/#{name}.xcscheme"
  File.write(scheme_path, scheme)
end
puts "Wrote #{NINJA_TARGETS.size} xcscheme files to #{schemes_dir}/"

puts "Done. TextMate.xcodeproj is ready."
