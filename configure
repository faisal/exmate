#!/bin/sh
# set -u
function error () { printf >&2 "%s\n\nPlease see README.md for build instructions.\n" "$1"; exit 1; }

# ===============================
# = Check required dependencies =
# ===============================

for dep in ninja ragel multimarkdown pgrep pkill; do
	which -s "$dep" || error "*** dependency missing: '${dep}'."
done

if [[ -e local.rave ]]; then
	echo >&2 "Skipping writing 'local.rave': File already exists"
else
	BREW_PREFIX="$(brew --prefix)"
	echo >> local.rave "add FLAGS    \"-I${BREW_PREFIX}/include\""
	echo >> local.rave "add FLAGS    \"-I\${dir}/vendor/capnp/vendor/c++/src\""
	echo >> local.rave "add LN_FLAGS \"-L${BREW_PREFIX}/lib\""

	for hdr in boost/{crc,variant}.hpp sparsehash/dense_hash_map; do
		test -f "${BREW_PREFIX}/include/${hdr}" || error "*** dependency missing: '${BREW_PREFIX}/include/${hdr}'. Install dependency and/or update 'local.rave' with correct path."
	done
fi

# ========================
# = Generate build files =
# ========================

if [[ -d "$builddir" ]];
	then bin/rave -crelease -tTextMate -b"$builddir"
	else bin/rave -crelease -tTextMate
fi
